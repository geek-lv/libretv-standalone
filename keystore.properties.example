# 正式签名用的密钥声明。复制成 keystore.properties 再填值; 那个文件和 keys/ 目录
# 都在 .gitignore 里, 不会被提交, 所以每个人的密钥可以放在自己顺手的位置。
#
# storeFile 相对项目根解析, 也可以写绝对路径:
#   storeFile=keys/release.jks          -> 项目内
#   storeFile=/var/secrets/release.jks  -> 项目外
# 文件不存在或口令为空时构建会回退 debug keystore, 并打一行 WARNING。
# 口令文件放在别处时: ./gradlew assembleRelease -PkeystoreProperties=<path>
storeFile=keys/release.jks
storePassword=
keyAlias=
keyPassword=
